# EditorConfig is awesome: https://editorconfig.org

root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

# Python files
[*.py]
indent_size = 4
max_line_length = 100

# JSON / YAML
[*.json]
indent_size = 2

[*.yml]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 4
