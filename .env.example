# Application
APP_ENV=dev

# CORS
CORS_ALLOW_ORIGINS=["*"]

# Database (SQLite by default; switch to Postgres by uncommenting below)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_code_review
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_code_review
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REVIEW_WORKER_CONCURRENCY=1

# GitLab
GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_TOKEN=dev-token
GITLAB_WEBHOOK_SECRET=dev-secret

# LLM
LLM_MODEL_NAME=local-llm
LLM_API_BASE=http://localhost:8001
LLM_API_KEY=dev-llm-key
LLM_TIMEOUT=30.0
LLM_STREAM_CONNECTION=false

# Logging
LOG_LEVEL=INFO
LOG_TO_CONSOLE=true

# crewAI behavior
CREW_ENABLE_CLOUD_TRACING=false
CREW_USE_STUB_LLM=false
CREW_FALLBACK_TO_STUB_ON_ERROR=true
CREW_POST_GITLAB_NOTE=true
CREW_POST_GITLAB_PROGRESS_NOTE=true
CREW_CACHE_ENABLED=true  # crew tool-result cache (passed to Crew(cache=...))
CREW_AGENT_MAX_ITER=15
CREW_ENABLE_GIT_TOOLS=true
